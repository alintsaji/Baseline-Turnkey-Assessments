                "unit": "size_unit_unspecified"
              },
              {
                "value": "sent_to_printer",
                "unit": "size_unit_unspecified"
              }
            ],
            "case_sensitive": false,
            "match_path_delimiters": false,
            "negated": false
          },
          {
            "field_name": "location",
            "operator": "is",
            "selector": "match_any",
            "values": [
              {
                "value": "removable_media",
                "unit": "size_unit_unspecified"
