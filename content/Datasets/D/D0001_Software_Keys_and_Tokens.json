  "version": "019e12ab-3092-74d1-b383-37ab5be92e7c",
  "name": "D0001 - Software Keys and Tokens",
  "description": "Intent: Cross-channel detection of software credentials (API keys, tokens, SSH keys) via content inspection — fires anywhere in the org regardless of channel when the ci-software-keys-and-tokens-policy CI tag matches. Requires content inspection to be enabled. Exclusions: gated by the CI tag itself (only flows containing detected secrets); validate CI rule precision against your repo / build output before enforcement to avoid noise on developer artifacts.",
  "sensitivity": "unrestricted",
  "domain": "corporate",
  "query": {
    "rules": [
      {
        "conditions": [
          {
            "field_name": "personal_info_counts",
            "operator": "has_multitag",
            "selector": "match_any",
            "values": [
              {
                "value": "ci-software-keys-and-tokens-policy",
                "min_count": 1,
                "unit": "size_unit_unspecified"
              }
            ],
            "case_sensitive": false,
            "match_path_delimiters": false,
            "negated": false
          }
        ]
      }
    ],
    "list_references": [],
    "exclusion_ids": []
  },
