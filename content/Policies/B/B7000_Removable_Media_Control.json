  "type": "data_protection",
  "name": "B7000 - Removable Media Control",
  "description": "Intent: Block-tier hard enforcement on Removable Media copy / move / rename_copy / download / save_as / sent_to_printer at sensitivity floor [3,4] — shuts down USB / SD / removable-storage exfil of sensitive content. Exclusions: excludes devices in USB_Authorized_Device_IDs_[is]; ships disabled by default — populate the Authorized USB list with every corporate encrypted device before enabling, otherwise legitimate copies will be blocked. Requirements: WIP — pending analyst testing.",
  "severity": "critical",
  "disabled": true,
  "query": {
    "rules": [
      {
        "conditions": [
          {
            "field_name": "event_type",
            "operator": "is",
            "selector": "match_any",
            "values": [
              {
                "value": "copy",
                "unit": "size_unit_unspecified"
              },
              {
                "value": "rename_copy",
                "unit": "size_unit_unspecified"
              },
              {
                "value": "download",
                "unit": "size_unit_unspecified"
              },
